# Vite only exposes env vars prefixed with VITE_
# Base URL for the single backend API (Fastify modular monolith)
# Recommended for dev (uses Vite proxy):
VITE_API_BASE_URL=/api/v1
# For deployed builds, set to a full URL if the API is on a different domain:
# VITE_API_BASE_URL=https://api.example.com/api/v1
