# Next.js Web Driver (static export)
# Base URL for the single backend API (includes /api/v1).
# Example when backend runs on :3001 and Next.js dev runs on :3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Back-compat (older name). Prefer NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:3001/api/v1
