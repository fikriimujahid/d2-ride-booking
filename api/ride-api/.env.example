# Ride API environment

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Postgres
# If you're using the repo docker-compose Postgres defaults:
# - user: postgres
# - db: ride_booking
# - password: from root .env POSTGRES_PASSWORD
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/ride_booking

# Auth context (abstracted)
# headers: derive AuthContext from X-Auth-* headers (dev-friendly)
# none: unauthenticated (routes that require auth will 401)
AUTH_CONTEXT_MODE=headers

# When AUTH_CONTEXT_MODE=headers, send these headers:
# X-Auth-Sub=00000000-0000-0000-0000-000000000001
# X-Auth-Role=passenger|driver|admin|system
# X-Auth-Scopes=rides:read,rides:accept
