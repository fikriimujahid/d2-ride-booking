    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.3",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
