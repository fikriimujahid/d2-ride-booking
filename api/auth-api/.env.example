# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ride_booking

# JWT
JWT_ISSUER=d2-ride-booking
# Audience values (enforced server-side)
JWT_AUD_ADMIN=admin-web
JWT_AUD_DRIVER=driver-app
JWT_AUD_PASSENGER=passenger-app

# Prefer asymmetric signing for production:
JWT_ALG=EdDSA
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KEY_ID=auth-2026-01

# If you must use symmetric signing (NOT recommended):
# JWT_ALG=HS256
# JWT_SECRET=change-me

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_TOKEN_TTL_SECONDS=300
ENROLL_TOKEN_TTL_SECONDS=600

# Admin web origin allowlist (comma-separated). Admin endpoints reject requests with missing/invalid Origin.
ADMIN_WEB_ORIGINS=https://admin.example.com

# Encryption key for Admin TOTP secrets (32 bytes, base64)
TOTP_ENC_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Seed data (dev/bootstrap)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Provide either email or phone for Driver/Passenger
SEED_DRIVER_EMAIL=driver@example.com
# SEED_DRIVER_PHONE=+15551234567
SEED_DRIVER_PASSWORD=ChangeMe123!

SEED_PASSENGER_EMAIL=passenger@example.com
# SEED_PASSENGER_PHONE=+15557654321
SEED_PASSENGER_PASSWORD=ChangeMe123!
