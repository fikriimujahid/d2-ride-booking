# Server
PORT=8080
NODE_ENV=development

# AWS Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_APP_CLIENT_ID=exampleclientid
# If your app client has a client secret, set this and enable secret hash.
COGNITO_APP_CLIENT_SECRET=

# Database (Prisma)
DATABASE_URL="mysql://user:password@localhost:3306/ridebooking"

# Seed (optional)
# Creates a Cognito user and assigns SUPER_ADMIN RBAC in DB.
SEED_SUPERADMIN_EMAIL="admin@example.com"
# Either set a temporary password (user will be forced to change it) OR a permanent one.
SEED_SUPERADMIN_TEMP_PASSWORD="TempPassword123!"
SEED_SUPERADMIN_PERMANENT_PASSWORD=
# If true, Cognito will not send invite email (recommended for local/dev seeding).
SEED_SUPERADMIN_SUPPRESS_INVITE=true
