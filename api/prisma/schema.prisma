generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id          String   @id @default(cuid())
  cognitoSub  String   @unique
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  roleAssignments AdminUserRole[]
  assignedRoleEvents AdminUserRole[] @relation("RoleAssignedBy")
  revokedRoleEvents  AdminUserRole[] @relation("RoleRevokedBy")
  grantedPermissionEvents AdminRolePermission[] @relation("PermissionGrantedBy")
  revokedPermissionEvents AdminRolePermission[] @relation("PermissionRevokedBy")
  auditEvents AdminRbacAuditEvent[] @relation("AuditActor")
  targetedAuditEvents AdminRbacAuditEvent[] @relation("AuditTarget")

  @@index([deletedAt])
}

model AdminRole {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  userAssignments AdminUserRole[]
  permissions     AdminRolePermission[]
  auditEvents     AdminRbacAuditEvent[]

  @@index([deletedAt])
}

model AdminPermission {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  rolePermissions AdminRolePermission[]
  auditEvents     AdminRbacAuditEvent[]

  @@index([deletedAt])
}

// Current assignment state for a given (adminUser, role).
// Historical transitions should be captured in AdminRbacAuditEvent.
model AdminUserRole {
  id          String   @id @default(cuid())
  adminUserId String
  roleId      String

  assignedAt  DateTime @default(now())
  assignedByAdminUserId String?

  revokedAt   DateTime?
  revokedByAdminUserId String?

  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedBy  AdminUser? @relation("RoleAssignedBy", fields: [assignedByAdminUserId], references: [id], onDelete: SetNull)
  revokedBy   AdminUser? @relation("RoleRevokedBy", fields: [revokedByAdminUserId], references: [id], onDelete: SetNull)

  @@unique([adminUserId, roleId])
  @@index([adminUserId])
  @@index([roleId])
  @@index([revokedAt])
  @@index([deletedAt])
}

// Current grant state for a given (role, permission).
model AdminRolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String

  grantedAt    DateTime @default(now())
  grantedByAdminUserId String?

  revokedAt    DateTime?
  revokedByAdminUserId String?

  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  grantedBy    AdminUser? @relation("PermissionGrantedBy", fields: [grantedByAdminUserId], references: [id], onDelete: SetNull)
  revokedBy    AdminUser? @relation("PermissionRevokedBy", fields: [revokedByAdminUserId], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([revokedAt])
  @@index([deletedAt])
}

// Append-only audit trail for admin RBAC changes.
// Keep this database-agnostic by storing metadata as a JSON string.
model AdminRbacAuditEvent {
  id              String   @id @default(cuid())
  action          String   @db.VarChar(64)
  at              DateTime @default(now())

  actorAdminUserId String?
  targetAdminUserId String?
  roleId           String?
  permissionId     String?

  ip              String?  @db.VarChar(45)
  userAgent       String?  @db.VarChar(512)
  metadata        String?  @db.Text

  actor           AdminUser? @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  targetAdminUser AdminUser? @relation("AuditTarget", fields: [targetAdminUserId], references: [id], onDelete: SetNull)
  role            AdminRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permission      AdminPermission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([action])
  @@index([actorAdminUserId])
  @@index([targetAdminUserId])
  @@index([roleId])
  @@index([permissionId])
}
