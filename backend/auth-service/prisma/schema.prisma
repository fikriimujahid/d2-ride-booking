generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  DRIVER
  PASSENGER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  MFA_SETUP
  MFA_FAILED
  LOGOUT
  PASSWORD_CHANGE
  ADMIN_ACTION
}

model User {
  id        String   @id @default(uuid())
  cognitoId String   @unique // Subject (sub) from Cognito
  email     String   @unique
  userType  UserType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  adminRoles AdminUserRole[]
  auditLogs  AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., SUPER_ADMIN, OPS_ADMIN
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  permissions RolePermission[]
  users       AdminUserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // e.g., "drivers", "financials"
  action      String   // e.g., "read", "write", "delete"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  ipAddress String?
  userAgent String?
  action    AuditAction
  details   Json?       // Store extra context
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
