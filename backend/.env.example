# Server
NODE_ENV=development
PORT=3000

# Database
# Local docker-compose defaults (see root docker-compose.yml)
DATABASE_URL=postgresql://user:rootpassword@localhost:5432/ridebooking?schema=public

# CORS: comma-separated origins
# Example: http://localhost:5173,https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# AWS Cognito (username/password via API; no Hosted UI)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: set only if your app client has a secret
COGNITO_CLIENT_SECRET=

# If USER_PASSWORD_AUTH is disabled on the app client, set this to true to use AdminInitiateAuth
COGNITO_USE_ADMIN_AUTH=false

# Optional: bootstrap SUPER_ADMIN user during `npm run db:seed`
# If SUPER_ADMIN_EMAIL is set, the seed will:
# - create/find the user in Cognito (AdminCreateUser)
# - set a permanent password if SUPER_ADMIN_PASSWORD is provided
# - upsert the user in Postgres and attach SUPER_ADMIN role
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=
