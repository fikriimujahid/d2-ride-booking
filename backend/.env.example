# Server
HOST=0.0.0.0
PORT=3001

# CORS (comma-separated list of allowed origins).
# - In development/test: if unset, all origins are allowed (to avoid dev port friction).
# - In production: set this to your CloudFront/S3 origins.
# Example: CORS_ORIGINS=https://admin.example.com,https://driver.example.com
CORS_ORIGINS=

# If true, include Access-Control-Allow-Credentials
CORS_CREDENTIALS=true
NODE_ENV=development

# Postgres (either set DATABASE_URL or the PG* vars)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/d2

PGHOST=localhost
PGPORT=5432
PGDATABASE=d2
PGUSER=postgres
PGPASSWORD=postgres

# Optional pool config
PGPOOL_MAX=10
PGSSL=false

# JWT (required)
# Generate strong secrets (>= 32 chars). Never commit real secrets.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
TOTP_ENCRYPTION_KEY_BASE64=change-me-totp-key

# TTLs
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# DB seed (optional)
# Used by: `npm run db:seed`
# If passwords are not set, the seed script defaults to "ChangeMe123!" (dev only).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

SEED_DRIVER_EMAIL=driver@example.com
SEED_DRIVER_PASSWORD=ChangeMe123!

SEED_PASSENGER_EMAIL=passenger@example.com
SEED_PASSENGER_PASSWORD=ChangeMe123!
