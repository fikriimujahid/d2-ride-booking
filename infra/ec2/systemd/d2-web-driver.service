[Unit]
Description=D2 Web Driver (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/d2/apps/web_driver/current
EnvironmentFile=-/etc/d2/web_driver.env
Environment=PORT=3001
ExecStart=/opt/d2/apps/web_driver/current/node_modules/.bin/next start -p ${PORT}
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
