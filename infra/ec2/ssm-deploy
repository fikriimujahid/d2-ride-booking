#!/usr/bin/env bash
set -euo pipefail

# ssm-deploy
# Downloads backend + web (Next.js) artifacts from S3, installs deps, switches symlinks, restarts services.
#
# Usage:
#   sudo /usr/local/bin/ssm-deploy <bucket> <release_id> <backend_key> <web_driver_key> <web_passenger_key>

BUCKET="${1:?bucket required}"
RELEASE_ID="${2:?release_id required}"
BACKEND_KEY="${3:-}" 
WEB_DRIVER_KEY="${4:-}"
WEB_PASSENGER_KEY="${5:-}"

BASE_DIR="/opt/d2/apps"
TMP_DIR="/tmp/d2-deploy-${RELEASE_ID}"

# Persistent npm cache to speed up installs between releases
NPM_CACHE_DIR="/opt/d2/npm-cache"

mkdir -p "$TMP_DIR"

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 2; }
}

require_cmd aws
require_cmd tar
require_cmd npm
require_cmd systemctl

# Optional secure runtime env management via SSM Parameter Store.
# Instance role must allow ssm:GetParameter for this prefix.
# Example parameters:
#   /mern-bootstrap/backend.env
#   /mern-bootstrap/web_passenger.env
SSM_PARAMETER_PREFIX="${SSM_PARAMETER_PREFIX:-/mern-bootstrap}"

maybe_sync_env_from_ssm() {
  local name="$1"      # backend|web_passenger
  local dest="$2"      # /etc/d2/backend.env
  local param="$SSM_PARAMETER_PREFIX/${name}.env"

  # Only attempt if ssm:GetParameter is allowed and parameter exists.
  if aws ssm get-parameter --name "$param" --with-decryption --query 'Parameter.Value' --output text >/tmp/d2-env.$$ 2>/dev/null; then
    mkdir -p "$(dirname "$dest")"
    chmod 755 "$(dirname "$dest")" || true
    mv /tmp/d2-env.$$ "$dest"
    chmod 600 "$dest" || true
    echo "Synced env: $param -> $dest"
  else
    rm -f /tmp/d2-env.$$ || true
    echo "No env parameter found (or access denied): $param"
  fi
}

print_stats() {
  echo "--- host stats ---"
  (command -v uptime >/dev/null 2>&1 && uptime) || true
  (command -v free >/dev/null 2>&1 && free -m) || true
  (command -v df >/dev/null 2>&1 && df -h) || true
  echo "------------------"
}

run_with_optional_timeout() {
  local minutes="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "${minutes}m" "$@"
  else
    "$@"
  fi
}

normalize_key() {
  local key="${1:-}"
  key="${key//$'\r'/}"
  key="${key#\"}"
  key="${key%\"}"
  key="${key#\'}"
  key="${key%\'}"
  printf '%s' "$key"
}

fetch_and_extract() {
  local app="$1"
  local key
  key="$(normalize_key "${2:-}")"
  local app_dir="$BASE_DIR/$app"
  local rel_dir="$app_dir/releases/$RELEASE_ID"
  local archive="$TMP_DIR/$app.tgz"

  mkdir -p "$rel_dir"

  echo "Downloading s3://$BUCKET/$key -> $archive"
  aws s3 cp "s3://$BUCKET/$key" "$archive" --only-show-errors

  echo "Extracting $app -> $rel_dir"
  tar -xzf "$archive" -C "$rel_dir"
}

should_deploy() {
  local key
  key="$(normalize_key "${1:-}")"
  [[ -n "$key" && "$key" != "-" && "$key" != "skip" ]]
}

switch_symlink() {
  local app="$1"
  local app_dir="$BASE_DIR/$app"
  local rel_dir="$app_dir/releases/$RELEASE_ID"

  mkdir -p "$app_dir"

  if [[ -L "$app_dir/current" ]]; then
    local prev
    prev="$(readlink -f "$app_dir/current")" || true
    if [[ -n "${prev:-}" ]]; then
      ln -sfn "$prev" "$app_dir/previous" || true
    fi
  fi

  ln -sfn "$rel_dir" "$app_dir/current"
}

deps_unchanged() {
  local app="$1"
  local app_dir="$BASE_DIR/$app"
  local prev_dir=""
  local prev_lock=""
  local cur_lock="$app_dir/current/package-lock.json"

  if [[ ! -f "$cur_lock" ]]; then
    return 1
  fi

  if [[ -L "$app_dir/previous" ]]; then
    prev_dir="$(readlink -f "$app_dir/previous")" || true
  fi

  if [[ -z "${prev_dir:-}" ]]; then
    return 1
  fi

  prev_lock="$prev_dir/package-lock.json"
  if [[ ! -f "$prev_lock" ]]; then
    return 1
  fi

  cmp -s "$prev_lock" "$cur_lock"
}

install_node_deps() {
  local app="$1"
  local wd="$BASE_DIR/$app/current"

  if deps_unchanged "$app" && [[ -d "$BASE_DIR/$app/previous/node_modules" ]]; then
    echo "Dependencies unchanged for $app; reusing previous node_modules"
    rm -rf "$wd/node_modules" || true
    cp -a "$BASE_DIR/$app/previous/node_modules" "$wd/node_modules"
    return 0
  fi

  echo "Installing production deps for $app"

  mkdir -p "$NPM_CACHE_DIR" || true
  export NPM_CONFIG_CACHE="$NPM_CACHE_DIR"

  # Keep the box responsive on small instances.
  local node_opts="${NODE_OPTIONS:---max_old_space_size=768}"

  if command -v nice >/dev/null 2>&1; then
    (cd "$wd" && run_with_optional_timeout 20 nice -n 10 env NODE_OPTIONS="$node_opts" npm ci --omit=dev --no-audit --no-fund --progress=false)
  else
    (cd "$wd" && run_with_optional_timeout 20 env NODE_OPTIONS="$node_opts" npm ci --omit=dev --no-audit --no-fund --progress=false)
  fi
}

# 1) Fetch + extract
mkdir -p "$BASE_DIR"

print_stats

if should_deploy "$BACKEND_KEY"; then
  fetch_and_extract backend "$BACKEND_KEY"
fi

if should_deploy "$WEB_DRIVER_KEY"; then
  fetch_and_extract web_driver "$WEB_DRIVER_KEY"
fi

if should_deploy "$WEB_PASSENGER_KEY"; then
  fetch_and_extract web_passenger "$WEB_PASSENGER_KEY"
fi

# 2) Switch symlinks
if should_deploy "$BACKEND_KEY"; then
  switch_symlink backend
fi

if should_deploy "$WEB_DRIVER_KEY"; then
  switch_symlink web_driver
fi

if should_deploy "$WEB_PASSENGER_KEY"; then
  switch_symlink web_passenger
fi

# 3) Install deps
if should_deploy "$BACKEND_KEY"; then
  install_node_deps backend
fi

if should_deploy "$WEB_DRIVER_KEY"; then
  install_node_deps web_driver
fi

if should_deploy "$WEB_PASSENGER_KEY"; then
  install_node_deps web_passenger
fi

# 4) Restart services
systemctl daemon-reload || true

if should_deploy "$BACKEND_KEY"; then
  maybe_sync_env_from_ssm backend /etc/d2/backend.env
  systemctl restart d2-backend.service
fi

if should_deploy "$WEB_DRIVER_KEY"; then
  systemctl restart d2-web-driver.service
fi

if should_deploy "$WEB_PASSENGER_KEY"; then
  maybe_sync_env_from_ssm web_passenger /etc/d2/web_passenger.env
  systemctl restart d2-web-passenger.service
fi

echo "Deploy complete: $RELEASE_ID"
