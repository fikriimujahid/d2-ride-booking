            "arn": "arn:aws:iam::731099197523:policy/github-actions-deploy-policy",
            "attachment_count": 0,
            "description": "Policy for github-actions-deploy-role",
            "id": "arn:aws:iam::731099197523:policy/github-actions-deploy-policy",
            "name": "github-actions-deploy-policy",
            "name_prefix": "",
            "path": "/",
            "policy": "{\"Statement\":[{\"Action\":[\"ec2:DescribeInstances\",\"ec2:DescribeTags\",\"ec2:CreateTags\"],\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"EC2DeploymentAccess\"},{\"Action\":[\"s3:PutObject\",\"s3:GetObject\",\"s3:ListBucket\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::d2-ride-booking-deployments-*\",\"arn:aws:s3:::d2-ride-booking-deployments-*/*\"],\"Sid\":\"S3ArtifactsUpload\"},{\"Action\":[\"cloudwatch:GetMetricData\",\"logs:FilterLogEvents\",\"logs:GetLogEvents\"],\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"CloudWatchReadOnly\"},{\"Action\":[\"ssm:SendCommand\",\"ssm:GetCommandInvocation\"],\"Condition\":{\"StringEquals\":{\"aws:ResourceTag/project\":\"d2-ride-booking\"}},\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:ec2:*:*:instance/*\",\"arn:aws:ssm:*:*:document/AWS-RunShellScript\"],\"Sid\":\"SSMRunCommand\"}],\"Version\":\"2012-10-17\"}",
            "policy_id": "ANPA2UOHIOBJ6P7T4472L",
            "tags": {
              "environment": "shared",
              "managed_by": "terraform",
              "project": "d2-ride-booking"
